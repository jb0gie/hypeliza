# Core Configuration
NODE_ENV=production
PORT=3000

# ============================================
# HYPERFY PLUGIN CONFIGURATION
# ============================================

# AI Provider API Keys (at least one required)
SCHWEPE_OPENAI_API_KEY=
SCHWEPE_ANTHROPIC_API_KEY=
SCHWEPE_GROQ_API_KEY=
SCHWEPE_GOOGLE_GENAI_API_KEY=
SCHWEPE_OPENROUTER_API_KEY=

# Hyperfy Configuration
# For local Hyperfy: ws://localhost:3011/ws
# For remote Hyperfy: wss://hyperfy.io/yourworld/ws
WS_URL=ws://localhost:3011/ws

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Discord Bot (optional)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Twitter Bot (optional)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# Livekit (optional, for voice features)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Database (optional, for SQL plugin)
DATABASE_URL=